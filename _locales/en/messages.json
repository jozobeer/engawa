  "helpOwnedTabs": {
    "message": "Like Arc, each favorite, each pinned tab and each GitHub pull request reuse one dedicated tab instead of opening a new one on every click. Only favorites become Chrome pinned tabs, which sit as small icons at the left of the tab strip, apart from your other tabs (the tabs of pinned tabs and pull requests stay ordinary tabs)."
  },
  "optGhDedicatedTab": {
    "message": "Open each pull request in its own dedicated tab (tabs are reused)"
